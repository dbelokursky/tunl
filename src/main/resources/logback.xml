<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
    <!-- The default is computed, not written down: LogDirPropertyDefiner asks
         PlatformPaths, so it is right on every OS and for every entry point,
         and it follows the vless.data.dir redirect a test run sets. The
         literal that used to stand here was the macOS path, and a test run
         inherited it — into the developer's real logs, whose history this
         appender then purged on start.
         vless.log.dir still overrides, for pointing a support build's logs
         somewhere specific. -->
    <define name="DEFAULT_LOG_DIR" class="com.vlessclient.app.LogDirPropertyDefiner"/>
    <property name="LOG_DIR" value="${vless.log.dir:-${DEFAULT_LOG_DIR}}"/>
    <property name="LOG_FILE" value="${LOG_DIR}/tunl.log"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/tunl.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>5</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
            <!-- Purge stale history at startup too, not only at rollover —
                 matters for a desktop app that can sit unopened for weeks. -->
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <!-- MCP audit trail: one tab-separated line per mutating agent call. Kept
         in its own rolling file (not tunl.log) so it stays a clean,
         greppable record. Bounded like the main log so it can't grow forever. -->
    <appender name="MCP_AUDIT" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/mcp-audit.log</file>
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/mcp-audit.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>5MB</maxFileSize>
            <maxHistory>5</maxHistory>
            <totalSizeCap>50MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <!-- additivity=false: audit lines go only to mcp-audit.log, not the console
         or the main app log. -->
    <logger name="mcp.audit" level="INFO" additivity="false">
        <appender-ref ref="MCP_AUDIT"/>
    </logger>

    <!-- INFO by default (packaged app); dev runs via `mvn javafx:run` pass
         -Dvless.log.level=DEBUG through the jvm-args argfile. Users can
         raise verbosity for troubleshooting the same way without a rebuild. -->
    <logger name="com.vlessclient" level="${vless.log.level:-INFO}"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
