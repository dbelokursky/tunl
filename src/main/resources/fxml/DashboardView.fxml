<?xml version="1.0" encoding="UTF-8"?>

<?import com.vlessclient.ui.view.PressableLabel?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.vlessclient.ui.view.DashboardViewController"
      spacing="18">

    <!-- Sing-box missing banner (hidden when engine is available) -->
    <HBox fx:id="singBoxMissingBanner" styleClass="singbox-missing-banner"
          spacing="12" alignment="CENTER_LEFT"
          visible="false" managed="false">
        <padding>
            <Insets top="12" right="16" bottom="12" left="16"/>
        </padding>
        <Label text="&#x26A0;" styleClass="banner-icon"/>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="singBoxMissingTitle" styleClass="banner-title"/>
            <Label fx:id="singBoxMissingHint" styleClass="banner-subtitle"/>
            <Label fx:id="brewCommandLabel" text="brew install sing-box" styleClass="banner-command"/>
        </VBox>
        <!-- Labels come from ButtonLabels.bind: the first swaps to "Copied!"
             on click, and both spellings have to survive a language switch.
             bind also pins each button to its widest label, which is what
             keeps them whole when this row runs short of room: an HBox short
             of room shrinks every child, whatever its hgrow, so the text
             beside them does not yield first
             (DashboardBannerButtonWidthTest). -->
        <Button fx:id="copyBrewButton" styleClass="secondary-button"
                onAction="#onCopyBrewCommandClicked"/>
        <Button fx:id="retryInstallButton" styleClass="secondary-button"
                onAction="#onRetryInstallClicked"/>
    </HBox>

    <!-- Update banner (hidden unless a newer release exists). Same shape as
         the one above, in an informational rather than a warning palette: a
         waiting update is news, not a problem. minWidth=0 + wrapText let the
         text wrap and give up its width at a narrow window. That is not what
         saves the button: an HBox short of room shrinks every child, whatever
         its hgrow. The button is whole because ButtonLabels.bind pins it to
         its label (DashboardBannerButtonWidthTest); a button labelled through
         bindStatic, as recheckButton is, needs minWidth="-Infinity" here. -->
    <HBox fx:id="updateBanner" styleClass="update-banner"
          spacing="12" alignment="CENTER_LEFT"
          visible="false" managed="false">
        <padding>
            <Insets top="12" right="16" bottom="12" left="16"/>
        </padding>
        <Label text="&#x2191;" styleClass="banner-icon"/>
        <VBox spacing="2" HBox.hgrow="ALWAYS" minWidth="0">
            <Label fx:id="updateBannerTitle" styleClass="banner-title"
                   wrapText="true" maxWidth="Infinity"/>
            <Label fx:id="updateBannerHint" styleClass="banner-subtitle"
                   wrapText="true" maxWidth="Infinity"/>
        </VBox>
        <!-- The action is wired in UpdateBannerSection, which owns when this
             button is shown at all. -->
        <Button fx:id="updateBannerButton" styleClass="secondary-button"/>
    </HBox>

    <!-- Servers the core refused to build, which the connection went ahead
         without (SkippedServersSection). Hidden unless the running core was
         started without some; the service empties the list when it stops. -->
    <HBox fx:id="skippedServersBanner" styleClass="skipped-servers-banner"
          alignment="CENTER_LEFT" visible="false" managed="false">
        <padding>
            <Insets top="8" right="12" bottom="8" left="12"/>
        </padding>
        <Label fx:id="skippedServersLabel" styleClass="skipped-servers-label"
               wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="0"/>
    </HBox>

    <!-- Subscriptions near their end: the plan expires within three days or
         has expired, or has used 90 % of its traffic (SubscriptionEndSection).
         Hidden unless one is. -->
    <HBox fx:id="subscriptionEndBanner" styleClass="skipped-servers-banner"
          alignment="CENTER_LEFT" visible="false" managed="false">
        <padding>
            <Insets top="8" right="12" bottom="8" left="12"/>
        </padding>
        <Label fx:id="subscriptionEndLabel" styleClass="skipped-servers-label"
               wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="0"/>
    </HBox>

    <!-- Local ports this session moved off because another program held the
         chosen ones (MovedPortsSection). Hidden unless the running core did. -->
    <HBox fx:id="movedPortsBanner" styleClass="skipped-servers-banner"
          alignment="CENTER_LEFT" visible="false" managed="false">
        <padding>
            <Insets top="8" right="12" bottom="8" left="12"/>
        </padding>
        <Label fx:id="movedPortsLabel" styleClass="skipped-servers-label"
               wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="0"/>
    </HBox>

    <!-- A REALITY server turned the core away: current Xray lets in only
         recent Xray clients by default. Hidden unless this run's traffic met
         such a refusal (SingBoxEngine.realityRefusedProperty). -->
    <HBox fx:id="realityRefusedBanner" styleClass="skipped-servers-banner"
          alignment="CENTER_LEFT" visible="false" managed="false">
        <padding>
            <Insets top="8" right="12" bottom="8" left="12"/>
        </padding>
        <Label fx:id="realityRefusedLabel" styleClass="skipped-servers-label"
               wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="0"/>
    </HBox>

    <!-- A tunnel that dropped where restarting it would raise the elevation
         prompt again: recovery leaves that reconnect to the user
         (TunnelRecoveryService). Hidden unless the service offers it.
         The button is pinned to its width: an HBox short of room shrinks
         every child in proportion, the wrapping label beside it did not
         shield it, and in Russian it read "Переп…" at the minimum width. -->
    <HBox fx:id="tunnelDroppedBanner" styleClass="tunnel-dropped-banner"
          spacing="12" alignment="CENTER_LEFT" visible="false" managed="false">
        <padding>
            <Insets top="8" right="12" bottom="8" left="12"/>
        </padding>
        <Label fx:id="tunnelDroppedLabel" styleClass="tunnel-dropped-label"
               wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="0"/>
        <Button fx:id="tunnelDroppedButton" styleClass="secondary-button" minWidth="-Infinity"
                onAction="#onReconnectDroppedTunnelClicked"/>
    </HBox>

    <!-- The running core was built from settings changed since: DNS, ports,
         TUN options, routing rules and the mode apply at the next start.
         Hidden unless ConnectionService.runsCurrentSettings says otherwise.
         The button is pinned to its width, as the one above. -->
    <HBox fx:id="pendingChangesBanner" styleClass="skipped-servers-banner"
          spacing="12" alignment="CENTER_LEFT" visible="false" managed="false">
        <padding>
            <Insets top="8" right="12" bottom="8" left="12"/>
        </padding>
        <Label fx:id="pendingChangesLabel" styleClass="skipped-servers-label"
               wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="0"/>
        <Button fx:id="pendingChangesButton" styleClass="secondary-button" minWidth="-Infinity"
                onAction="#onReconnectForChangesClicked"/>
    </HBox>

    <!-- Status hero: two rows so nothing is clipped at a narrow window.
         Row 1 is the status (full width, subtitle free to wrap/ellipsize);
         row 2 carries the Mode selector + Connect button on their own line,
         so the fixed-width controls never fight the status text for space. -->
    <VBox styleClass="card, hero-card, status-bar" spacing="14">
        <!-- Row 1: status -->
        <HBox alignment="CENTER_LEFT" spacing="16">
            <StackPane fx:id="statusHalo" styleClass="status-halo, status-halo-sm"
                       prefWidth="44" prefHeight="44" maxWidth="44" maxHeight="44">
                <Circle fx:id="statusCircle" radius="9" styleClass="status-circle-disconnected"/>
            </StackPane>

            <VBox spacing="1" HBox.hgrow="ALWAYS" minWidth="0">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <StackPane fx:id="statusFlag" minWidth="0" managed="false" visible="false"/>
                    <Label fx:id="statusTitle" text="Disconnected" styleClass="status-title"/>
                </HBox>
                <Label fx:id="statusLabel" text="Add a server to get started"
                       styleClass="status-subtitle" wrapText="true" maxWidth="Infinity"/>
                <!-- First run: the one action that makes Connect possible,
                     shown only while the server list is empty. -->
                <Hyperlink fx:id="addServerLink" visible="false" managed="false"
                           onAction="#onAddServerLinkClicked"/>
            </VBox>

            <!-- Traffic readout, merged in from the retired "Real-time
                 traffic" section. The card's subtitle already says the tunnel
                 is routing traffic; these are the numbers behind that
                 sentence, so they belong in the same row rather than 200px
                 further down.

                 minWidth=-Infinity because the subtitle next to it is
                 wrapText + hgrow with minWidth=0: without the pin, a long
                 server name would push the numbers out of the card instead
                 of wrapping itself. Hidden until a tunnel is up — there is no
                 traffic to report while disconnected, and the row then looks
                 exactly as it did before this block existed. -->
            <VBox fx:id="trafficSummary" alignment="CENTER_RIGHT" spacing="1"
                  minWidth="-Infinity" visible="false" managed="false">
                <!-- Speeds are the part that only means something while a
                     tunnel is up; the total line below them outlives the
                     session, because it is also the handle for the history. -->
                <HBox fx:id="trafficSpeeds" alignment="CENTER_RIGHT" spacing="14">
                    <HBox fx:id="uploadReadout" alignment="CENTER_LEFT" spacing="3">
                        <Label fx:id="uploadCardIcon" styleClass="stats-icon-upload"/>
                        <Label fx:id="uploadSpeedLabel" text="0 B/s" styleClass="speed-value"/>
                    </HBox>
                    <HBox fx:id="downloadReadout" alignment="CENTER_LEFT" spacing="3">
                        <Label fx:id="downloadCardIcon" styleClass="stats-icon-download"/>
                        <Label fx:id="downloadSpeedLabel" text="0 B/s" styleClass="speed-value"/>
                    </HBox>
                </HBox>
                <!-- Pressable: the one way into the traffic history has to
                     work from the keyboard and for a screen reader too. -->
                <PressableLabel fx:id="sessionTotalLabel" text="—"
                                styleClass="session-total, session-total-link"
                                onMouseClicked="#onSessionTotalClicked"/>
            </VBox>
        </HBox>

        <!-- Row 2: mode + connect. The spacer pushes Connect to the right;
             it collapses first when the window is narrow, so the fixed combo
             and button always stay on screen. The TUN warning wraps under. -->
        <VBox spacing="4">
            <HBox alignment="CENTER_LEFT" spacing="12" fillHeight="false">
                <!-- The labels are pinned to their natural width: they name the
                     control in two words, so ellipsizing them to "..." costs
                     the whole meaning. The combos carry values instead, and
                     truncating a value still leaves it recognisable, so they
                     are the ones allowed to give up width first. The combo
                     minimums are what lets the row still fit the 500px content
                     width DashboardFitTest pins, now that the labels cannot
                     shrink. -->
                <Label fx:id="modeLabel" text="Mode" styleClass="stats-title" minWidth="-Infinity"/>
                <!-- 190 is measured, not chosen: "Системный прокси" needs 178
                     in the cell plus the arrow, and at 150 the mode was
                     truncated at every window size rather than only at the
                     narrow ones this row is designed to give up width at. Both
                     combos take the same width — they are peers in one row. -->
                <ComboBox fx:id="proxyModeCombo" prefWidth="190" minWidth="60" styleClass="mode-combo"/>
                <Label fx:id="serverSelectionLabel" styleClass="stats-title" minWidth="-Infinity"/>
                <ComboBox fx:id="serverSelectionCombo" prefWidth="190" minWidth="60" styleClass="mode-combo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- No width here: the controller pins it from the four labels
                     this button can show, in whatever language is on. -->
                <Button fx:id="connectButton" text="Connect" styleClass="connect-button"
                        onAction="#onConnectClicked" prefHeight="44"/>
            </HBox>
            <Label fx:id="proxyModeWarning" text="" styleClass="hint-label"
                   wrapText="true" maxWidth="Infinity" visible="false" managed="false"/>
        </VBox>

        <!-- Traffic history, opened by clicking the session total in row 1.
             Collapsed by default and remembered in settings, so the card is
             exactly what it was before this existed until someone asks for
             more. The bars are built in TrafficHistorySection: 30 of them,
             one per day, and a fixed count is what lets them be plain Regions
             in an HBox rather than another canvas.

             Read-only on purpose: clearing the record is in Settings. A Clear
             link at the end of this header sat where the pointer already
             works, and was one stray click from wiping the record. -->
        <VBox fx:id="trafficHistoryPanel" styleClass="traffic-history" spacing="8"
              visible="false" managed="false">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="trafficHistoryTitle" text="Last 30 days" styleClass="stats-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="trafficHistoryServers" styleClass="session-total"/>
            </HBox>

            <!-- The bars live inside a StackPane so the day popover can be an
                 unmanaged child of it. Coordinates then start at the bar row
                 itself, a negative layoutY floats the card above the chart,
                 and none of it reaches the layout pass — which is what keeps
                 opening a day from moving a single pixel of the card.

                 maxWidth/maxHeight=Infinity on the HBox because a StackPane
                 sizes each child to its own maximum, and the computed default
                 would leave the row at its pref width with the bars bunched
                 on the left. -->
            <StackPane fx:id="trafficHistoryBarsHost" alignment="BOTTOM_LEFT"
                       minHeight="46" prefHeight="46" maxHeight="46">
                <HBox fx:id="trafficHistoryBars" styleClass="traffic-history-bars"
                      alignment="BOTTOM_LEFT" spacing="3"
                      maxWidth="Infinity" maxHeight="Infinity"/>
            </StackPane>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label fx:id="trafficHistoryRange" styleClass="session-total"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="trafficHistoryMonth" styleClass="session-total"/>
            </HBox>
        </VBox>
    </VBox>

    <!-- Hidden legacy field used elsewhere; no longer rendered. -->
    <Label fx:id="serverNameLabel" text="" managed="false" visible="false"/>

    <!-- Service availability: reachability of key services through the tunnel -->
    <VBox fx:id="healthCard" styleClass="card" spacing="10"
          visible="false" managed="false">
        <HBox alignment="CENTER_LEFT" spacing="10" fillHeight="true">
            <Label fx:id="healthSectionTitle" text="Service availability" styleClass="section-header"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="healthSummaryLabel" text="—" styleClass="latency-result"/>
            <Button fx:id="addTargetButton" text="+" styleClass="secondary-button"
                    minWidth="40" onAction="#onAddTargetClicked"/>
            <Button fx:id="recheckButton" text="Re-check" styleClass="secondary-button"
                    prefWidth="140" minWidth="-Infinity" onAction="#onRecheckClicked"/>
        </HBox>

        <VBox fx:id="serviceStatusList" spacing="6"/>

        <HBox fx:id="reconnectBanner" styleClass="reconnect-banner" spacing="12"
              alignment="CENTER_LEFT" visible="false" managed="false">
            <padding>
                <Insets top="8" right="12" bottom="8" left="12"/>
            </padding>
            <Label fx:id="reconnectBannerLabel" text="" styleClass="reconnect-banner-label"
                   wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <!-- Pinned to its own width: the label beside it wraps, and in a
                 narrow window it would squeeze "Disconnect" to "Disc…". -->
            <Button fx:id="cancelReconnectButton" text="Cancel" styleClass="secondary-button"
                    minWidth="-Infinity" onAction="#onCancelReconnectClicked"/>
        </HBox>
    </VBox>
</VBox>
