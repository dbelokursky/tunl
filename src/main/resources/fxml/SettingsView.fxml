<?xml version="1.0" encoding="UTF-8"?>

<?import com.vlessclient.ui.view.FittedTextArea?>
<?import com.vlessclient.ui.view.WrappingRow?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.vlessclient.ui.view.SettingsViewController"
      spacing="20">
    <!-- A plain box, not a ScrollPane: MainViewController mounts every page in
         ContentScrollPane, and a scroll pane of this view's own nested inside
         it drew a second vertical bar beside the wrapper's. No padding of its
         own either: MainView's content area already insets every page by 24,
         and the 16 this added on top made the Settings cards jump inward
         against the Servers list and every other view. No background of its
         own, for the same reason: it wore the server form's .form-content,
         which painted the window colour over the page colour every other
         page shows. -->

    <!-- Title -->
    <Label fx:id="titleLabel" text="Settings" styleClass="view-title"/>

    <!-- Appearance Section -->
    <VBox spacing="12" styleClass="card">
        <Label fx:id="appearanceLabel" text="Appearance" styleClass="form-section-title"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="themeLabel" text="Theme" styleClass="form-label, settings-gutter"/>
            <ComboBox fx:id="themeCombo" styleClass="form-field" prefWidth="300"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="languageLabel" text="Language" styleClass="form-label, settings-gutter"/>
            <ComboBox fx:id="languageCombo" styleClass="form-field" prefWidth="300"/>
        </HBox>
    </VBox>

    <!-- Connection Section -->
    <VBox spacing="12" styleClass="card">
        <Label fx:id="connectionLabel" text="Connection" styleClass="form-section-title"/>

        <CheckBox fx:id="autoConnectCheck" text="Auto-connect on startup" styleClass="form-checkbox"/>

        <CheckBox fx:id="launchAtLoginCheck" text="Launch at login" styleClass="form-checkbox"/>

        <Separator styleClass="sidebar-separator"/>

        <Label fx:id="proxyPortsLabel" text="Proxy Ports" styleClass="form-label"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="socksPortLabel" text="SOCKS Port"
                   styleClass="form-label, settings-gutter"/>
            <TextField fx:id="socksPortField" styleClass="form-field" prefWidth="110"
                       promptText="1080"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="httpPortLabel" text="HTTP Port" styleClass="form-label, settings-gutter"/>
            <TextField fx:id="httpPortField" styleClass="form-field" prefWidth="110"
                       promptText="1081"/>
        </HBox>

        <Separator styleClass="sidebar-separator"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="coreLogLevelLabel" text="Core log level"
                   styleClass="form-label, settings-gutter"/>
            <ComboBox fx:id="coreLogLevelCombo" styleClass="form-field" prefWidth="300"/>
        </HBox>

        <Label fx:id="coreLogLevelHint" styleClass="hint-label" wrapText="true"
               maxWidth="Infinity"/>

        <Separator styleClass="sidebar-separator"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="proxyModeLabel" text="Proxy Mode"
                   styleClass="form-label, settings-gutter"/>
            <ComboBox fx:id="proxyModeCombo" styleClass="form-field" prefWidth="300"/>
        </HBox>

        <CheckBox fx:id="systemProxyAutoConfigCheck" text="Set system proxy automatically"
                  styleClass="form-checkbox"/>
    </VBox>

    <!-- Health Check Section -->
    <VBox spacing="12" styleClass="card">
        <Label fx:id="healthCheckLabel" text="Health Check" styleClass="form-section-title"/>

        <CheckBox fx:id="healthCheckEnabledCheck" text="Enable health check"
                  styleClass="form-checkbox"/>

        <CheckBox fx:id="healthCheckAutoReconnectCheck" text="Auto-reconnect when unreachable"
                  styleClass="form-checkbox"/>

        <Separator styleClass="sidebar-separator"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="healthCheckIntervalLabel" text="Check interval (sec)"
                   styleClass="form-label, settings-gutter"/>
            <TextField fx:id="healthCheckIntervalField" styleClass="form-field" prefWidth="110"
                       promptText="5"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <!-- Wraps rather than ellipsizes: in Russian this is the one label
                 that outgrows the 210 gutter, needing about 243px under the
                 DejaVu Sans the Linux CI renders it in. -->
            <Label fx:id="healthCheckReconnectDelayLabel" text="Reconnect delay (sec)"
                   styleClass="form-label, settings-gutter" wrapText="true"/>
            <TextField fx:id="healthCheckReconnectDelayField" styleClass="form-field" prefWidth="110"
                       promptText="10"/>
        </HBox>
    </VBox>

    <!-- Advanced Section -->
    <VBox spacing="12" styleClass="card">
        <Label fx:id="advancedLabel" text="Advanced" styleClass="form-section-title"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="proxyDnsLabel" text="Proxy DNS" styleClass="form-label, settings-gutter"/>
            <TextField fx:id="proxyDnsField" styleClass="form-field" prefWidth="300"
                       promptText="https://1.1.1.1/dns-query"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="directDnsLabel" text="Direct DNS"
                   styleClass="form-label, settings-gutter"/>
            <TextField fx:id="directDnsField" styleClass="form-field" prefWidth="300"
                       promptText="system"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="dnsStrategyLabel" text="DNS Strategy"
                   styleClass="form-label, settings-gutter"/>
            <ComboBox fx:id="dnsStrategyCombo" styleClass="form-field" prefWidth="300"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="tunInterfaceNameLabel" text="TUN Interface Name"
                   styleClass="form-label, settings-gutter"/>
            <TextField fx:id="tunInterfaceNameField" styleClass="form-field" prefWidth="300"
                       promptText="utun99"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="tunIpv4Label" text="TUN IPv4 Address"
                   styleClass="form-label, settings-gutter"/>
            <TextField fx:id="tunIpv4Field" styleClass="form-field" prefWidth="300"
                       promptText="172.19.0.1/30"/>
        </HBox>

        <CheckBox fx:id="tunIpv6Check" text="Route IPv6 through the tunnel"
                  styleClass="form-checkbox"/>
        <Label fx:id="tunIpv6Hint" styleClass="hint-label" wrapText="true" maxWidth="520"
               text="Off, IPv6 traffic bypasses the VPN on dual-stack networks. Applies in TUN mode."/>

        <CheckBox fx:id="shareLocalProxyCheck" text="Let other programs use the local proxy in TUN mode"
                  styleClass="form-checkbox"/>
        <Label fx:id="shareLocalProxyHint" styleClass="hint-label" wrapText="true" maxWidth="520"
               text="Off, the local SOCKS and HTTP proxies ask for a password only Tunl knows."/>

        <CheckBox fx:id="storeSecretsCheck" text="Store credentials in the system keychain"
                  styleClass="form-checkbox"/>
        <!-- Shown while the box is on and the keychain does not work, when the
             credentials go into the files instead. -->
        <Label fx:id="storeSecretsHint" styleClass="hint-label" wrapText="true" maxWidth="520"
               visible="false" managed="false"
               text="The system keychain is not available here, so credentials are saved in files only your account can read."/>

        <!-- The ID gives way when the row is short of room, at a narrow
             window or a larger text size: the label and the button keep
             their own widths. All three used to shrink together, so at 125%
             in Russian the label and "Сбросить…" were cut as well. Where the
             label and the button do not fit on one line, the ID and the
             button go on to the next: pinned in one HBox, at 150% the row
             made the page wider than the window and hid every combo's
             arrow. The label wraps only where the row is narrower than the
             gutter, at 200%. The button goes under the ID only where a line
             is too short for the two, and is cut only where it is too short
             for the button alone: pinned to its width, at 225% in the
             smallest window in Russian it made the page wider than the
             window again. -->
        <WrappingRow hgap="10" vgap="6">
            <Label fx:id="deviceIdLabel" text="Device ID for subscriptions"
                   styleClass="form-label, settings-gutter" wrapText="true"/>
            <WrappingRow hgap="10" vgap="6" HBox.hgrow="ALWAYS">
                <Label fx:id="deviceIdValue" text="" styleClass="stats-value" minWidth="0"
                       HBox.hgrow="ALWAYS"/>
                <Button fx:id="deviceIdResetButton" text="Reset…" styleClass="secondary-button"
                        onAction="#onResetDeviceId"/>
            </WrappingRow>
        </WrappingRow>
        <Label fx:id="deviceIdHint" styleClass="hint-label" wrapText="true" maxWidth="520"
               text="Sent to subscription providers."/>
    </VBox>

    <!-- Agent Control (MCP) Section -->
    <VBox spacing="12" styleClass="card">
        <Label fx:id="mcpSectionTitle" text="Agent Control (MCP)" styleClass="form-section-title"/>

        <Label fx:id="mcpHintLabel" text="Expose a local, loopback-only MCP server so AI agents can read status/logs and manage the client. Guarded by a bearer token."
               styleClass="status-subtitle" wrapText="true" maxWidth="520"/>

        <CheckBox fx:id="mcpEnabledCheck" text="Enable MCP server" styleClass="form-checkbox"/>

        <!-- The status goes under the port where the two do not fit beside
             each other, and wraps where a line of its own is too short for
             it. Squeezed in beside the field, at 125% text size it read
             "○ sto…", at 150% "○ …" whether the server ran or not, and the
             reason a start failed was cut even at the usual size. -->
        <WrappingRow hgap="12" vgap="6">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <!-- 210 and 110: the label gutter and the numeric-field width
                     every other label+field row in this view uses. At 120/120
                     this row's field started 90px left of all of them. -->
                <Label fx:id="mcpPortLabel" text="Port" styleClass="form-label, settings-gutter"/>
                <TextField fx:id="mcpPortField" styleClass="form-field" prefWidth="110"
                           promptText="55555"/>
            </HBox>
            <Label fx:id="mcpStatusLabel" text="" styleClass="stats-value, settings-status"
                   wrapText="true"/>
        </WrappingRow>

        <CheckBox fx:id="mcpAllowMutationsCheck"
                  text="Allow configuration changes (connect, edit servers, routing)"
                  styleClass="form-checkbox"/>

        <Separator styleClass="sidebar-separator"/>

        <Label fx:id="mcpCommandLabel" text="Add to Claude Code (copy &amp; run):" styleClass="form-label"/>
        <!-- As tall as the command at the width the window leaves it: a row
             count fits one width, and the command runs to four lines at
             the smallest window. -->
        <FittedTextArea fx:id="mcpCommandArea" editable="false" wrapText="true"
                        styleClass="form-field"/>

        <!-- One under the other where the two do not fit beside each other,
             at 150% text size, rather than both cut short. -->
        <WrappingRow hgap="12" vgap="8">
            <Button fx:id="mcpCopyButton" text="Copy command" styleClass="secondary-button"
                    onAction="#onCopyMcpCommand"/>
            <Button fx:id="mcpRegenButton" text="Regenerate token" styleClass="secondary-button"
                    onAction="#onRegenerateMcpToken"/>
        </WrappingRow>
    </VBox>

    <!-- Traffic history: the record behind the dashboard's history panel,
         and the only place it can be cleared. It used to be a Clear link
         in that panel, where the pointer already works; see
         TrafficHistorySettingsSection. The summary is written by the
         section, so it carries no placeholder text. -->
    <VBox spacing="12" styleClass="card">
        <Label fx:id="trafficHistoryLabel" text="Traffic history"
               styleClass="form-section-title"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="trafficHistoryRecordedLabel" text="Recorded"
                   styleClass="form-label, settings-gutter"/>
            <!-- Wraps rather than ellipsizes: a Russian date beside the
                 210 gutter is the widest thing in the card at the 500px
                 ViewFitTest pins. -->
            <Label fx:id="trafficHistorySummary" styleClass="stats-value, settings-value"
                   wrapText="true"
                   maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        </HBox>

        <Label fx:id="trafficHistoryHint" styleClass="hint-label" wrapText="true"
               maxWidth="Infinity"/>

        <!-- Alone and right-aligned, like the update row in About: the
             action sits under the facts it acts on. Free to shrink, so only
             a row narrower than its label cuts it: pinned to that width, at
             200% in Russian it reached past the page. -->
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button fx:id="clearTrafficHistoryButton" text="Clear history…"
                    styleClass="secondary-button"/>
        </HBox>
    </VBox>

    <!-- About Section -->
    <VBox spacing="12" styleClass="card">
        <Label fx:id="aboutLabel" text="About" styleClass="form-section-title"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="appVersionLabel" text="App Version"
                   styleClass="form-label, settings-gutter"/>
            <Label fx:id="appVersionValue" text="1.0.0" styleClass="stats-value, settings-value"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="singboxVersionLabel" text="sing-box Version"
                   styleClass="form-label, settings-gutter"/>
            <Label fx:id="singboxVersionValue" text="Unknown"
                   styleClass="stats-value, settings-value"/>
        </HBox>

        <!-- Required by the country database's CC BY 4.0 licence: the
             attribution has to be visible in the product, not only in the
             repository. -->
        <Label fx:id="geoAttributionLabel" styleClass="hint-label"
               wrapText="true" maxWidth="Infinity"/>

        <!-- The update actions, and nothing else. There is no heading and
             no divider above them: both version rows already say what is
             happening to them, so a section called "Updates" separated by
             a rule was announcing a section that had become two buttons. -->
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <!-- Present only while an update is staged and waiting, so the
                 row is a single button in every other state. -->
            <Button fx:id="appUpdateButton" text="Restart now" visible="false"
                    managed="false" styleClass="secondary-button"/>
            <Button fx:id="checkUpdatesButton" text="Check for updates"
                    styleClass="secondary-button"/>
        </HBox>
    </VBox>

</VBox>
