<?xml version="1.0" encoding="UTF-8"?>

<?import com.vlessclient.ui.view.WrappingRow?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.vlessclient.ui.view.ServersViewController"
      fx:id="rootNode"
      spacing="16">

    <!-- Header. The buttons go on to a line of their own when the title
         and they do not fit on one: shrunk to fit it, at 125% text size
         Backup and Import were drawn as "..." and "И...", and could not be
         told apart. -->
    <WrappingRow hgap="12" vgap="8">
        <Label fx:id="titleLabel" text="Servers" styleClass="view-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <WrappingRow hgap="12" vgap="8">
            <!-- Export/import of the whole list. A menu rather than two more
                 buttons: the header already carries two, and a third and fourth
                 overflow the 500px viewport in Russian. Its items are built by
                 the controller so their labels follow the locale. -->
            <MenuButton fx:id="backupMenuButton" text="Backup" styleClass="secondary-button"/>
            <!-- Share links in: straight from the clipboard, or typed into the
                 link dialog. A menu for the same reason as Backup: at 500px the
                 Russian header was already short of room for these three, so the
                 clipboard could not have a button of its own, and the Russian
                 "Import" is narrower than the "Import Link" button this replaced.
                 Its items are built by the controller too. -->
            <MenuButton fx:id="importMenuButton" text="Import" styleClass="secondary-button"/>
            <Button fx:id="addServerButton" text="+ Add Server" styleClass="primary-button"
                    onAction="#onAddServerClicked"/>
        </WrappingRow>
    </WrappingRow>

    <!-- Search and sort. Hidden while there are no servers: it would only
         offer to narrow an empty list. -->
    <WrappingRow fx:id="filterBar" hgap="10" vgap="8">
        <TextField fx:id="searchField" styleClass="form-field" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="sortCombo" styleClass="form-field" prefWidth="190"/>
        <Button fx:id="measureButton" styleClass="secondary-button"
                onAction="#onMeasureClicked"/>
    </WrappingRow>

    <!-- Server List. prefHeight="120" for the reason LogsView gives: at
         ListView's own 400 the page overflowed the 820x500 window. -->
    <ListView fx:id="serverListView" styleClass="server-list" VBox.vgrow="ALWAYS"
              prefHeight="120"/>

    <!-- Empty state hint -->
    <VBox fx:id="emptyState" styleClass="empty-state" spacing="8" alignment="CENTER"
          VBox.vgrow="ALWAYS" managed="true" visible="true">
        <Label text="&#x1F5A5;" styleClass="empty-state-icon"/>
        <Label fx:id="emptyStateTitle" styleClass="empty-state-title"/>
        <Label fx:id="emptyStateHint" styleClass="empty-state-hint"/>
    </VBox>
</VBox>
