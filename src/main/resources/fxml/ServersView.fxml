<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.vlessclient.ui.view.ServersViewController"
      spacing="16">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label fx:id="titleLabel" text="Servers" styleClass="view-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <!-- Export/import of the whole list. A menu rather than two more
             buttons: the header already carries two, and a third and fourth
             overflow the 500px viewport in Russian. Its items are built by
             the controller so their labels follow the locale. -->
        <MenuButton fx:id="backupMenuButton" text="Backup" styleClass="secondary-button"/>
        <Button fx:id="importLinkButton" text="Import Link" styleClass="secondary-button"
                onAction="#onImportLinkClicked"/>
        <Button fx:id="addServerButton" text="+ Add Server" styleClass="primary-button"
                onAction="#onAddServerClicked"/>
    </HBox>

    <!-- Search and sort. Hidden while there are no servers: it would only
         offer to narrow an empty list. -->
    <HBox fx:id="filterBar" alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="searchField" styleClass="form-field" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="sortCombo" styleClass="form-field" prefWidth="190"/>
        <Button fx:id="measureButton" styleClass="secondary-button"
                onAction="#onMeasureClicked"/>
    </HBox>

    <!-- Server List -->
    <ListView fx:id="serverListView" styleClass="server-list" VBox.vgrow="ALWAYS"/>

    <!-- Empty state hint -->
    <VBox fx:id="emptyState" styleClass="empty-state" spacing="8" alignment="CENTER"
          VBox.vgrow="ALWAYS" managed="true" visible="true">
        <Label text="&#x1F5A5;" styleClass="empty-state-icon"/>
        <Label fx:id="emptyStateTitle" styleClass="empty-state-title"/>
        <Label fx:id="emptyStateHint" styleClass="empty-state-hint"/>
    </VBox>
</VBox>
