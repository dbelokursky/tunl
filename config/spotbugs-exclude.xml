<?xml version="1.0" encoding="UTF-8"?>
<!--
    Pattern-level exclusions for SpotBugs (excludeFilterFile in pom.xml).

    Findings suppressed here are suppressed by their nature, not one by one:
    the hash baseline (spotbugs-baseline.xml) pins individual findings to a
    method signature, so every refactor that touches a listed signature broke
    the build until the hash was regenerated. 88 of its 99 entries were the
    two patterns below.
-->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!--
        EI_EXPOSE_REP / EI_EXPOSE_REP2: "may expose internal representation by
        returning (or storing) a reference to a mutable object". In a JavaFX
        application the mutable objects handed around are the point: controls
        given to a coordinator record, observable lists and properties that
        several views bind to, the ConfigStore's live server list, Path fields.
        Copying them would break the binding they exist for. Where a defensive
        copy is genuinely required (the model package's lists), it is enforced
        by ModelDefensiveCopyTest rather than by this detector.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
