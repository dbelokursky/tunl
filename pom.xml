<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.vlessclient</groupId>
    <artifactId>vless-client</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Tunl</name>
    <description>Cross-platform multi-protocol proxy client wrapping sing-box with a JavaFX GUI</description>
    <url>https://github.com/dbelokursky/tunl</url>

    <!-- The bundled sing-box binary stays under its own GPL-3.0 licence; it is
         a separate process, not a dependency of this artifact. See NOTICE. -->
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.minimum.version>3.9.0</maven.minimum.version>
        <maven.compiler.release>25</maven.compiler.release>
        <!-- Must stay on a GA line. 28-ea was an early-access build in a
             product handed to users: EA artifacts are unsupported, can be
             withdrawn from Central, and change under a fixed coordinate. 26.0.2
             is the newest GA - the 27 line exists only as -ea. -->
        <javafx.version>26.0.2</javafx.version>
        <junit.version>6.1.3</junit.version>
        <jackson.version>3.2.2</jackson.version>
        <logback.version>1.6.3</logback.version>
        <slf4j.version>2.0.18</slf4j.version>
        <maxmind-db.version>4.1.0</maxmind-db.version>
        <assertj.version>3.27.7</assertj.version>
        <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
        <spotbugs.baselineFile>${project.basedir}/config/spotbugs-baseline.xml</spotbugs.baselineFile>
        <spotbugs.excludeFilterFile>${project.basedir}/config/spotbugs-exclude.xml</spotbugs.excludeFilterFile>
        <main.class>com.vlessclient.app.Launcher</main.class>
        <!-- singbox.version is read from src/main/resources/singbox.properties
             by the properties-maven-plugin (initialize phase) — the single
             source of truth shared with bundle-singbox.sh and SingBoxInstaller. -->
        <!-- Smoke tests (@Tag "smoke") run the real bundled binary; excluded
             by default, enabled with -Psmoke. -->
        <surefire.excludedGroups>smoke</surefire.excludedGroups>
        <!-- Safe default so surefire's @{argLine} resolves even when the
             JaCoCo agent is skipped (prepare-agent overwrites this). -->
        <argLine></argLine>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Jackson for JSON -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <!-- SLF4J + Logback -->
        <!-- MMDB reader only (Apache-2.0); the country database itself is
             DB-IP Lite (CC BY 4.0), downloaded at runtime rather than bundled
             so the installer does not carry data that expires monthly. -->
        <dependency>
            <groupId>com.maxmind.db</groupId>
            <artifactId>maxmind-db</artifactId>
            <version>${maxmind-db.version}</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-core</artifactId>
            <version>4.0.18</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-junit5</artifactId>
            <version>4.0.18</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>openjfx-monocle</artifactId>
            <version>21.0.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Loads singbox.version + checksums from singbox.properties so
                the pom, the bundling script, and the Java runtime all read
                the same pinned release. Runs at initialize, before the
                generate-resources executions that consume ${singbox.version}.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>properties-maven-plugin</artifactId>
                <version>1.3.0</version>
                <executions>
                    <execution>
                        <id>read-singbox-properties</id>
                        <phase>initialize</phase>
                        <goals><goal>read-project-properties</goal></goals>
                        <configuration>
                            <files>
                                <file>${project.basedir}/src/main/resources/singbox.properties</file>
                            </files>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                The generate-resources shell steps — bundle the sing-box binary
                into target/classes/native/ (so the JAR is self-contained and
                SingBoxInstaller extracts it on first run) and write the JVM
                argfile — go through exec-maven-plugin, but the tooling differs
                per OS (bash vs PowerShell). They live in the OS-activated
                bundle-core-* profiles below so a build only ever runs its own
                platform's scripts.
            -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                    <options>
                        <!--
                            macOS: make the application name shown in the
                            menu bar ("Quit <name>", "Hide <name>") and
                            the Dock title read "Tunl".

                            JavaFX's glass bridge ignores
                            apple.awt.application.name, so we must pass
                            -Xdock:name on the JVM command line. But the
                            javafx-maven-plugin (commons-exec) splits
                            option values on whitespace, destroying the
                            literal space. Workaround: write the option
                            into a Java argfile at generate-resources
                            time (scripts/write-jvm-args.sh) and pass
                            @path to that file, which is a single
                            whitespace-free token.
                        -->
                        <option>@${project.build.directory}/jvm-args.txt</option>
                    </options>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <!-- @{argLine} lets the JaCoCo agent attach (prepare-agent
                         sets the argLine property); a bare literal here
                         silently disables coverage collection. -->
                    <!-- The native-access grant below: JavaFX loads its
                         glass/prism natives through System.load from the
                         classpath's unnamed module. Since JDK 24 (JEP 472)
                         that prints a "restricted method" warning at startup,
                         and a later release turns it into an error. Granted
                         here for the forked test JVM; the packaging scripts
                         and the dev argfile grant it for the app itself. -->
                    <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                    <systemPropertyVariables>
                        <!--
                            Prevent tests from writing the bundled sing-box
                            binary into the user's real ~/Library/Application
                            Support cache, which can trigger macOS Gatekeeper
                            prompts on first run.
                        -->
                        <vless.singbox.skipBundled>true</vless.singbox.skipBundled>
                        <vless.singbox.installDir>${project.build.directory}/test-singbox-install</vless.singbox.installDir>
                        <!--
                            Same idea one level up: every service resolving
                            through PlatformPaths (ConfigStore, RoutingService,
                            SubscriptionService, the log dir) must stay out of
                            the developer's real profile. Without this the UI
                            tests load the actual servers.json and settings.json
                            and hit the real OS keychain, so they assert against
                            a populated world locally and an empty one on CI.
                        -->
                        <vless.data.dir>${project.build.directory}/test-data-dir</vless.data.dir>
                        <!--
                            Headless JavaFX for the whole suite. The UI tests
                            always set these per-class, but service tests that
                            call Platform.startup (LogReaderTest,
                            SingBoxEngineTest) relied on the real glass
                            toolkit — which works on the mac/windows runners
                            but hangs on display-less Linux waiting for X.
                            Monocle behaves identically everywhere.
                        -->
                        <glass.platform>Monocle</glass.platform>
                        <monocle.platform>Headless</monocle.platform>
                        <prism.order>sw</prism.order>
                        <prism.text>t2k</prism.text>
                        <testfx.robot>glass</testfx.robot>
                        <testfx.headless>true</testfx.headless>
                        <java.awt.headless>true</java.awt.headless>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <!-- 0.8.13+ understands Java 25 (class file 69) bytecode. -->
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <!-- Floor, not target. Coverage differs by
                                         OS because platform-specific tests are
                                         skipped. The 2026-09 main baseline is
                                         64.2% on macOS; the cross-platform CI
                                         runs 859 tests but skips 55 on Windows
                                         versus 6 on macOS. Keep enough headroom
                                         for that spread and raise this floor as
                                         coverage grows. -->
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.55</minimum>
                                        </limit>
                                        <!-- Branches were ungated, so an error
                                             path could lose all its coverage
                                             without failing the build - the
                                             lines around it stay covered. The
                                             2026-09 main baseline is 52.99%
                                             (2092/3948) on macOS; this floor
                                             keeps the same ~11pp headroom the
                                             LINE floor above leaves for the
                                             Windows/Linux spread. -->
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.42</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <dependencies>
                    <!-- Pin the Checkstyle engine so the vendored config below
                         always resolves against a known module set. -->
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>14.1.0</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <!-- Google's ruleset, vendored so we can set 4-space indentation. -->
                    <configLocation>config/checkstyle/google_checks.xml</configLocation>
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                    <!-- Enforced: google_checks emits "warning" severity, so gate on it. -->
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>warning</violationSeverity>
                    <consoleOutput>true</consoleOutput>
                </configuration>
                <executions>
                    <execution>
                        <id>validate</id>
                        <phase>validate</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.10.4.0</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <failOnError>true</failOnError>
                    <!-- Two layers: the exclude filter drops whole bug patterns
                         that are noise for a JavaFX app (see the file), the
                         baseline pins the handful of intentional findings by
                         signature hash. Keep the baseline small - a hash entry
                         breaks the build whenever its method signature moves. -->
                    <excludeFilterFile>${spotbugs.excludeFilterFile}</excludeFilterFile>
                    <excludeBugsFile>${spotbugs.baselineFile}</excludeBugsFile>
                    <xmlOutput>true</xmlOutput>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[${maven.minimum.version},)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[${maven.compiler.release},)</version>
                                </requireJavaVersion>
                                <dependencyConvergence/>
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.vlessclient.app.Launcher</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Runs the smoke suite (real bundled sing-box binary) in addition
             to the regular tests: mvn clean verify -Psmoke -->
        <profile>
            <id>smoke</id>
            <properties>
                <surefire.excludedGroups/>
            </properties>
        </profile>

        <!-- Bundle the sing-box core for the build host's OS. Split by OS so a
             build never ships the wrong platform's binary: macOS bundles the
             darwin tar.gz via bash, Windows the amd64 zip via PowerShell. The
             executions share the id 'bundle-sing-box' but only one profile is
             ever active, so they don't collide. -->
        <profile>
            <id>bundle-core-macos</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>bundle-sing-box</id>
                                <phase>generate-resources</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/scripts/bundle-singbox.sh</argument>
                                        <argument>${project.build.directory}/classes/native</argument>
                                        <argument>${singbox.version}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>write-jvm-args</id>
                                <phase>generate-resources</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/scripts/write-jvm-args.sh</argument>
                                        <argument>${project.build.directory}/jvm-args.txt</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>bundle-core-windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>bundle-sing-box</id>
                                <phase>generate-resources</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>powershell</executable>
                                    <arguments>
                                        <argument>-NoProfile</argument>
                                        <argument>-ExecutionPolicy</argument>
                                        <argument>Bypass</argument>
                                        <argument>-File</argument>
                                        <argument>${project.basedir}/scripts/bundle-singbox.ps1</argument>
                                        <argument>-OutDir</argument>
                                        <argument>${project.build.directory}/classes/native</argument>
                                        <argument>-Version</argument>
                                        <argument>${singbox.version}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>write-jvm-args</id>
                                <phase>generate-resources</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>powershell</executable>
                                    <arguments>
                                        <argument>-NoProfile</argument>
                                        <argument>-ExecutionPolicy</argument>
                                        <argument>Bypass</argument>
                                        <argument>-File</argument>
                                        <argument>${project.basedir}/scripts/write-jvm-args.ps1</argument>
                                        <argument>-OutFile</argument>
                                        <argument>${project.build.directory}/jvm-args.txt</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>bundle-core-linux</id>
            <activation>
                <os><name>Linux</name></os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec-maven-plugin.version}</version>
                        <executions>
                            <!-- Same bash scripts as macOS: bundle-singbox.sh
                                 picks linux-amd64 from uname, write-jvm-args.sh
                                 drops the -Xdock flags off macOS. -->
                            <execution>
                                <id>bundle-sing-box</id>
                                <phase>generate-resources</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/scripts/bundle-singbox.sh</argument>
                                        <argument>${project.build.directory}/classes/native</argument>
                                        <argument>${singbox.version}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>write-jvm-args</id>
                                <phase>generate-resources</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/scripts/write-jvm-args.sh</argument>
                                        <argument>${project.build.directory}/jvm-args.txt</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
